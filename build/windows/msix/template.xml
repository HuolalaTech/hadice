<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Hadice"
        Arguments=""
        InstallLocation="C:\Program Files\Hadice">
    </Installer>
    <PackageInformation
        PackageName="Hadice"
        PackageDisplayName="Hadice"
        PublisherName="CN=Haivo"
        PublisherDisplayName="Haivo"
        Version="1.2.0.0"
        PackageDescription="HarmonyOS Device Testing and Debugging Tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.haivo.hadice"
                Description="HarmonyOS Device Testing and Debugging Tool"
                DisplayName="Hadice"
                ExecutableName="Hadice"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hadice</DisplayName>
            <PublisherDisplayName>Haivo</PublisherDisplayName>
            <Description>HarmonyOS Device Testing and Debugging Tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="Hadice.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
